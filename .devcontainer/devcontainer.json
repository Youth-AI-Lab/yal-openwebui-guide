{
  "name": "Youth AI Lab — group chatbots with Open WebUI",
  // The same image as the workshop kit (Docker, the openwebui command), in group mode:
  // Open WebUI with accounts, opened to the participants for a session (openwebui share).
  // A pinned tag, never `latest`: each version of the guide is tested with one image.
  "image": "ghcr.io/youth-ai-lab/yal-workshop-devcontainer:2026.10.24",
  "remoteUser": "vscode",
  "remoteEnv": {
    "WORKSHOP_HOME": "${containerWorkspaceFolder}",
    "OPENWEBUI_MODE": "class"
  },
  // Open WebUI uses about 1.2 GB: 8 GB of memory (the default 2-core machine).
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  // The command shows the address when everything is ready (no tab opened before).
  "portsAttributes": {
    "3000": { "label": "Open WebUI", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": { "extensions": ["mathematic.vscode-pdf"] }
  }
}
